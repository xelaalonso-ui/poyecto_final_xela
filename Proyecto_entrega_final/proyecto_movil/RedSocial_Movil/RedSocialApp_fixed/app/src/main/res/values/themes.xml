<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RedSocial" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pink_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/gradient_start</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="materialButtonStyle">@style/Widget.RedSocial.Button</item>
        <item name="editTextStyle">@style/Widget.RedSocial.EditText</item>
    </style>

    <!-- Botón principal -->
    <style name="Widget.RedSocial.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/purple_500</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Botón outline -->
    <style name="Widget.RedSocial.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/purple_500</item>
        <item name="android:textColor">@color/purple_500</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- EditText -->
    <style name="Widget.RedSocial.EditText" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/purple_300</item>
        <item name="hintTextColor">@color/text_hint</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <!-- Card -->
    <style name="Widget.RedSocial.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.RedSocial.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/transparent</item>
        <item name="titleTextColor">@color/white</item>
    </style>

    <!-- Splash -->
    <style name="Theme.RedSocial.Splash" parent="Theme.RedSocial">
        <item name="android:statusBarColor">@color/gradient_start</item>
    </style>

    <!-- BottomNav -->
    <style name="Widget.RedSocial.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@drawable/nav_icon_tint</item>
        <item name="itemTextColor">@drawable/nav_icon_tint</item>
        <item name="android:background">@color/white</item>
        <item name="elevation">8dp</item>
    </style>
</resources>
